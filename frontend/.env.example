# GridSentinel Frontend Environment Variables Template
# Copy this file to .env.local for local development or configure in your deployment platform.
# NEVER commit production API keys, secrets, or real tokens to version control.

# FastAPI Backend REST API base URL (e.g., http://localhost:8000 for local development)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend Live Telemetry WebSocket endpoint (e.g., ws://localhost:8000/ws/live for local development)
# IMPORTANT: Production environments over HTTPS must use the secure WebSocket protocol (wss://)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# Mapbox Public Access Token for GIS Feeder Map view (optional)
# If left empty, GridSentinel automatically uses the autonomous offline Vector SCADA Schematic engine.
NEXT_PUBLIC_MAPBOX_TOKEN=
